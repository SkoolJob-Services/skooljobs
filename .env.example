# Copy to .env.development.local (or .env.local) and fill in. This file is committed; the copies are not.
# `npm run dev:mock` ignores the API settings below and uses the in-browser mock.

# Use real APIs instead of mock APIs
VITE_USE_MOCK_API=false

# Sent as X-Client-Id / X-Tenant-Code on every request — must match the tenant set up in
# system-configuration for SkoolJobs (same values as apps/skooljobs/dev.env in the deployment repo).
VITE_CLIENT_ID=skooljobs-web
VITE_TENANT_CODE=SKOOLJOBS
VITE_DEFAULT_COUNTRY_CODE=+91

# Remote dev environment: Vite forwards /api/<service>/… and /ws/notifications to this host.
# Comment it out to use the local services (DEV_*_API_TARGET below) instead.
VITE_API_PROXY_TARGET=https://dev.app.skooljobs.com

# Signup service base path (login, signup, invites)
VITE_API_BASE_URL=/api/signup

# Only for builds not served behind the edge nginx (e.g. the Capacitor app); empty = same origin
#VITE_API_ORIGIN=https://dev.app.skooljobs.com

# Website images (logo, partner logos, blog photos). After `npm run site:assets` use /site-assets
#VITE_SITE_MEDIA_BASE=/site-assets

# Local services (used only when VITE_API_PROXY_TARGET is not set)
#DEV_SIGNUP_API_TARGET=http://localhost:8080
#DEV_SCHOOL_PROFILE_API_TARGET=http://localhost:8081
#DEV_JOB_API_TARGET=http://localhost:8085
#DEV_TEACHER_PROFILE_API_TARGET=http://localhost:8086
#DEV_APPLICATION_API_TARGET=http://localhost:8087
#DEV_NOTIFICATION_WS_TARGET=ws://localhost:8080

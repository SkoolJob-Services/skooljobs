# Local settings for `npm run dev`. Copy to .env.local (git-ignored) and adjust.
# In Docker the same settings come from the container environment (env.js),
# see deployment repo apps/skooljobs/<env>.env.

# --- Signup service (login, signup, invites) ---
# true = in-browser mock, OTP is always 123456 (same as `npm run dev:mock`)
VITE_USE_MOCK_API=false
# Base path of the signup service; /api/signup is proxied to DEV_SIGNUP_API_TARGET
VITE_API_BASE_URL=http://dev.app.skooljobs.com/api/signup
# Must match a Tenants record in system-configuration (SkoolJobs: skooljobs-web / SKOOLJOBS)
VITE_CLIENT_ID=skooljobs-web
VITE_TENANT_CODE=SKOOLJOBS
VITE_DEFAULT_COUNTRY_CODE=+91

# --- Dev proxy targets (vite.config.js) ---
DEV_SIGNUP_API_TARGET=http://dev.app.skooljobs.com/api/signup
# DEV_SCHOOL_PROFILE_API_TARGET=http://localhost:8081
# DEV_JOB_API_TARGET=http://localhost:8085
# DEV_TEACHER_PROFILE_API_TARGET=http://localhost:8086
# DEV_APPLICATION_API_TARGET=
# DEV_NOTIFICATION_WS_TARGET=ws://localhost:8080

# Only for builds not served behind the edge nginx (e.g. the Capacitor app)
# VITE_API_ORIGIN=https://skooljobs.example.com
